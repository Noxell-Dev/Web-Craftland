---
import { t } from '../i18n/es';
---

<section id="modalidades" class="bg-night-950 py-20 sm:py-28" aria-labelledby="modes-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <h2 id="modes-title" class="font-display text-3xl tracking-wide sm:text-4xl">{t.modes.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist-400">{t.modes.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.modes.items.map((mode, i) => (
        <article
          class="reveal block-border border border-white/8 bg-night-800 p-7 transition-colors hover:border-grape-600"
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-grape-300">{mode.tagline}</p>
          <h3 class="mt-3 font-display text-2xl tracking-wide">{mode.name}</h3>
          <p class="mt-3 leading-relaxed text-mist-400">{mode.description}</p>
          <ul class="mt-5 space-y-2 border-t border-white/8 pt-5">
            {mode.points.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-mist-200">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-lime-online" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
