---
import { t } from '../i18n/es';
---

<section id="modalidades" class="relative overflow-hidden bg-night-950 py-20 sm:py-28" aria-labelledby="modes-title">
  <!-- Degradado de continuidad desde el hero (foto -> noche) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-night-950/80 to-transparent" aria-hidden="true"></div>

  <!-- Cristales de amatista flotando (SVG propio, tres profundidades) -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg class="absolute -left-8 top-16 h-24 w-24 opacity-30 blur-[1px]" viewBox="0 0 100 100" fill="none">
      <path d="M50 5 68 40 50 95 32 40Z" fill="#8A2BE2" fill-opacity="0.45"/>
      <path d="M50 5 68 40 50 95Z" fill="#B17EE8" fill-opacity="0.35"/>
    </svg>
    <svg class="absolute right-[12%] top-24 h-14 w-14 opacity-40" viewBox="0 0 100 100" fill="none">
      <path d="M50 5 68 40 50 95 32 40Z" fill="#8A2BE2" fill-opacity="0.5"/>
    </svg>
    <svg class="absolute left-[18%] bottom-24 h-16 w-16 rotate-12 opacity-25 blur-[2px]" viewBox="0 0 100 100" fill="none">
      <path d="M50 5 68 40 50 95 32 40Z" fill="#8A2BE2" fill-opacity="0.4"/>
    </svg>
    <svg class="absolute right-[30%] bottom-10 h-10 w-10 -rotate-12 opacity-30" viewBox="0 0 100 100" fill="none">
      <path d="M50 5 68 40 50 95 32 40Z" fill="#B17EE8" fill-opacity="0.45"/>
    </svg>
    <svg class="absolute left-[45%] top-1/2 h-8 w-8 rotate-45 opacity-10 blur-[3px]" viewBox="0 0 100 100" fill="none">
      <path d="M50 5 68 40 50 95 32 40Z" fill="#8A2BE2" fill-opacity="0.35"/>
    </svg>
    <!-- Resplandor tenue de geoda -->
    <div class="absolute -right-24 top-1/3 h-72 w-72 rounded-full bg-grape-600/12 blur-3xl"></div>
    <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-grape-700/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <h2 id="modes-title" class="font-display text-3xl tracking-wide sm:text-4xl">{t.modes.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist-400">{t.modes.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.modes.items.map((mode, i) => (
        <article
          class="reveal block-border border border-white/8 bg-night-800 p-7 transition-colors hover:border-grape-600"
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-grape-300">{mode.tagline}</p>
          <h3 class="mt-3 font-display text-2xl tracking-wide">{mode.name}</h3>
          <p class="mt-3 leading-relaxed text-mist-400">{mode.description}</p>
          <ul class="mt-5 space-y-2 border-t border-white/8 pt-5">
            {mode.points.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-mist-200">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-lime-online" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
