---
import { t } from '../i18n/es';
---

<section id="modalidades" class="relative py-20 sm:py-28" aria-labelledby="modes-title">
  <!-- Degradado de continuidad desde el hero (foto -> noche) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-night-950/80 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <h2 id="modes-title" class="font-display text-3xl tracking-wide sm:text-4xl">{t.modes.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist-400">{t.modes.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3" style="perspective: 1200px">
      {t.modes.items.map((mode, i) => (
        <article
          data-tilt
          class="glow-card reveal group relative rounded-2xl border border-white/10 bg-night-800 transition-colors hover:border-grape-600"
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <span class="glow-edge" aria-hidden="true"></span>
          <div class="tilt-glare pointer-events-none absolute inset-0 z-10 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
          <div class="tilt-inner relative overflow-hidden rounded-2xl">
            <div class="relative h-64 overflow-hidden">
              <img
                src={`/images/modes/${mode.id}.webp`}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-night-800 via-night-800/20 to-transparent" aria-hidden="true"></div>
            </div>
            <div class="p-7 pt-5">
              <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-grape-300">{mode.tagline}</p>
              <h3 class="mt-3 font-display text-2xl tracking-wide">{mode.name}</h3>
              <p class="mt-3 leading-relaxed text-mist-400">{mode.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
