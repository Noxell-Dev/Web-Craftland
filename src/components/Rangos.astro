---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<section id="rangos" class="relative py-24 sm:py-28" aria-labelledby="rangos-title">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-grape-400">{t.ranks.overline}</p>
    <h2 id="rangos-title" data-split class="reveal mt-3 font-display text-4xl tracking-wide text-mist-50 sm:text-5xl">
      {t.ranks.title}
    </h2>
    <p class="reveal mt-4 max-w-2xl text-mist-400 leading-relaxed" style="--reveal-delay: 120ms">
      {t.ranks.subtitle}
    </p>

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="reveal relative mx-auto w-full max-w-lg" style="--reveal-delay: 80ms">
        <div
          aria-hidden="true"
          class="absolute inset-x-8 top-10 aspect-square rounded-full bg-grape-500/25 blur-3xl"
        ></div>
        <img
          src="/images/ranks/rangos.webp"
          alt="Cuatro guerreros de Craftland con los colores de los rangos: VIP, Héroe, Leyenda y Eterno"
          width="1084"
          height="520"
          loading="lazy"
          decoding="async"
          class="ranks-float relative z-10 mx-auto w-full max-w-[560px] drop-shadow-[0_28px_36px_rgba(0,0,0,0.55)] transition-transform duration-500 hover:scale-[1.04]"
        />
      </div>

      <div>
        {/* De menos a más importancia: cada rango más grande y con más presencia */}
        <ul class="reveal flex flex-col gap-3" style="--reveal-delay: 140ms" role="list">
          {site.ranks.map((rank) => (
            <li
              data-spotlight
              style={`--spot-color: ${rank.spot}`}
              class:list={[
                'spotlight-card group relative overflow-hidden rounded-2xl border transition-transform duration-200 hover:-translate-y-1',
                rank.id === 'vip' && 'border-emerald-500/30 bg-emerald-500/5 p-4',
                rank.id === 'heroe' && 'border-sky-500/40 bg-sky-500/10 p-5',
                rank.id === 'leyenda' && 'border-amber-500/50 bg-amber-500/10 p-6',
                rank.id === 'eterno' && 'border-rose-500/60 bg-gradient-to-br from-rose-500/25 via-rose-500/10 to-transparent p-7',
              ]}
            >
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <img
                    src={`/images/ranks/${rank.id}.webp`}
                    alt=""
                    aria-hidden="true"
                    width="256"
                    height="256"
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      'shrink-0 object-contain drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]',
                      rank.id === 'vip' && 'h-10 w-10',
                      rank.id === 'heroe' && 'h-12 w-12',
                      rank.id === 'leyenda' && 'h-14 w-14',
                      rank.id === 'eterno' && 'h-16 w-16',
                    ]}
                  />
                  <div>
                    <p class:list={[
                      'font-display tracking-wide',
                      rank.id === 'vip' && 'text-lg text-emerald-300',
                      rank.id === 'heroe' && 'text-xl text-sky-300',
                      rank.id === 'leyenda' && 'text-2xl text-amber-300',
                      rank.id === 'eterno' && 'text-3xl text-rose-200',
                    ]}>
                      {rank.id === 'eterno' ? <span data-shiny>{rank.label}</span> : rank.label}
                    </p>
                    <p class:list={[
                      'mt-0.5 text-mist-400',
                      rank.id === 'eterno' ? 'text-base text-mist-300' : 'text-sm',
                    ]}>{rank.tagline}</p>
                  </div>
                </div>
                {rank.id === 'eterno' && (
                  <span class="shrink-0 rounded-full border border-rose-400/40 bg-rose-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-200">
                    El más exclusivo
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
        <div class="reveal mt-8 flex flex-wrap items-center gap-4" style="--reveal-delay: 200ms">
          <span class="star-border" data-magnet>
            <a
              href={site.discordUrl}
              rel="noopener"
              class="btn-gloss inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-grape-400 to-grape-600 px-6 py-3 font-bold text-white shadow-[0_6px_24px_rgba(138,43,226,0.45)] transition-shadow hover:shadow-[0_8px_32px_rgba(138,43,226,0.65)]"
            >
              {t.ranks.storeCta}
            </a>
          </span>
          <a
            href={site.discordUrl}
            rel="noopener"
            data-magnet
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3 font-bold text-mist-50 transition-colors hover:bg-white/10"
          >
            {t.ranks.compareCta}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
