---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<section id="mapa" class="relative overflow-hidden py-20 sm:py-28" aria-labelledby="mapa-title">
  <div class="absolute left-1/2 top-0 h-64 w-[42rem] -translate-x-1/2 rounded-full bg-grape-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grape-300">{t.mapa.overline}</p>
      <h2 id="mapa-title" class="mt-4 font-display text-3xl tracking-wide text-mist-50 sm:text-4xl">{t.mapa.title}</h2>
      <p class="mt-5 leading-relaxed text-mist-300">{t.mapa.subtitle}</p>
    </div>

    <a
      href={site.mapUrl}
      target="_blank"
      rel="noopener"
      class="reveal group relative mt-10 block overflow-hidden border border-white/10"
      style="--reveal-delay: 120ms"
      aria-label={t.mapa.openCta}
    >
      <img
        src="/images/mapa-hero.webp"
        alt="Mapa interactivo del Survival de Craftland con el logo del servidor"
        width="1600"
        height="949"
        loading="lazy"
        decoding="async"
        class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-night-950/70 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 flex justify-center p-6">
        <span class="bg-grape-500 px-8 py-3 font-bold text-white transition-all group-hover:bg-grape-400 group-hover:shadow-[0_8px_32px_rgba(138,43,226,0.5)]">
          {t.mapa.openCta} ↗
        </span>
      </div>
    </a>

    <div class="mx-auto mt-10 grid max-w-4xl gap-5 sm:grid-cols-3">
      {t.mapa.features.map((f, i) => (
        <div
          class="reveal border border-white/10 bg-night-800/60 p-6 backdrop-blur-sm"
          style={`--reveal-delay: ${200 + i * 100}ms`}
        >
          <p class="font-display text-lg tracking-wide text-mist-50">{f.title}</p>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
