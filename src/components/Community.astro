---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<section id="comunidad" class="relative overflow-hidden bg-night-950 py-20 sm:py-28" aria-labelledby="community-title">
  <!-- Banda visual: segunda foto real del lobby -->
  <figure class="reveal mx-auto mb-16 max-w-6xl px-4 sm:px-6">
    <img
      src="/images/gallery/lobby-2.webp"
      alt="Plaza del lobby de Craftland con farolas y caminos empedrados entre pinos"
      width="1600"
      height="856"
      class="block-border w-full rounded-xl object-cover shadow-[0_25px_60px_-20px_rgba(0,0,0,0.8)]"
      loading="lazy"
      decoding="async"
    />
    <figcaption class="mt-3 text-center font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-mist-500">
      {t.community.galleryCaption}
    </figcaption>
  </figure>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <h2 id="community-title" class="font-display text-3xl tracking-wide sm:text-4xl">{t.community.title}</h2>
        <p class="mt-5 leading-relaxed text-mist-400">{t.community.subtitle}</p>

        <dl class="mt-8 grid grid-cols-3 gap-4">
          {t.community.stats.map((stat) => (
            <div class="border-l-2 border-grape-600 pl-4">
              <dt class="order-2 mt-1 text-sm text-mist-500">{stat.label}</dt>
              <dd
                class="font-display text-3xl text-grape-300"
                {...(stat.count !== undefined
                  ? { 'data-count-up': String(stat.count), 'data-count-prefix': stat.value.startsWith('+') ? '+' : '' }
                  : {})}
              >
                {stat.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="reveal block-border border border-grape-700/50 bg-night-800 p-8 text-center lg:justify-self-end" style="--reveal-delay: 120ms">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-grape-600/25">
          <svg class="h-9 w-9 text-grape-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28c-1.69.28-3.35.77-4.93 1.51A20.26 20.26 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.3-2.1a12.9 12.9 0 0 1-2.05-.98c.17-.12.34-.25.5-.38a14.2 14.2 0 0 0 12.16 0c.16.13.33.26.5.38-.65.39-1.34.71-2.05.98.37.73.81 1.44 1.3 2.1a19.84 19.84 0 0 0 6.07-3.03 20.2 20.2 0 0 0-3.58-13.69zM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42z"/>
          </svg>
        </div>
        <h3 class="mt-5 font-display text-2xl tracking-wide">{t.community.discordTitle}</h3>
        <p class="mt-3 text-mist-400">{t.community.discordDescription}</p>
        <a
          href={site.discordUrl}
          rel="noopener"
          class="mt-6 inline-block rounded-xl bg-grape-500 px-8 py-3.5 font-bold text-white transition-colors hover:bg-grape-400 active:translate-y-px btn-gloss"
        >
          {t.community.discordCta}
        </a>
      </div>
    </div>
  </div>
</section>
