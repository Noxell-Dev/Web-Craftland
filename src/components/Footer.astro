---
import { t } from '../i18n/es';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-night-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-display text-xl tracking-wide">CRAFT<span class="text-grape-400">LAND</span></p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-mist-500">{t.footer.description}</p>
      </div>

      <nav aria-label="Pie de página">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-mist-500">Navegación</p>
        <ul class="mt-3 space-y-2">
          {t.nav.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-mist-400 hover:text-mist-50">{link.label}</a>
            </li>
          ))}
          <li><a href="/aviso-legal" class="text-sm text-mist-400 hover:text-mist-50">Aviso legal</a></li>
        </ul>
      </nav>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-mist-500">Servidor</p>
        <ul class="mt-3 space-y-2 text-sm text-mist-400">
          <li class="font-mono">{site.serverIp}</li>
          <li>{site.versions}</li>
          <li>
            <a href={site.discordUrl} rel="noopener" class="hover:text-mist-50">Discord</a>
          </li>
          <li>
            <a href={site.tiktokUrl} target="_blank" rel="noopener" class="hover:text-mist-50">TikTok</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/5 pt-6 sm:flex-row">
      <p class="text-xs text-mist-500">© {year} {site.name}. No afiliado a Mojang Studios.</p>
      <a href="https://noxell.dev" rel="noopener" class="text-xs font-semibold text-mist-500 hover:text-mist-200">
        {t.footer.madeBy}
      </a>
    </div>
  </div>
</footer>
