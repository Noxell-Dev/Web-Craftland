---
import { t } from '../i18n/es';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section id="faq" class="bg-night-900 py-20 sm:py-28" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h2 id="faq-title" class="reveal text-center font-display text-3xl tracking-wide sm:text-4xl">{t.faq.title}</h2>

    <div class="mt-10 space-y-3">
      {t.faq.items.map((faq, i) => (
        <div
          class="reveal block-border border border-white/8 bg-night-800"
          data-accordion="closed"
          style={`--reveal-delay: ${i * 50}ms`}
        >
          <h3>
            <button
              type="button"
              class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left font-semibold text-mist-50"
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
              id={`faq-button-${i}`}
            >
              <span>{faq.question}</span>
              <svg class="h-5 w-5 shrink-0 text-grape-400 transition-transform duration-200" data-accordion-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </h3>
          <div id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-button-${i}`} data-accordion-panel>
            <div>
              <p class="px-6 pb-5 leading-relaxed text-mist-400">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
