---
import { t } from '../i18n/es';
import { site } from '../data/site';

// Lineas del titulo para el efecto de trazado (delays escalonados por letra)
const titleLines = [
  { text: t.hero.titleTop.toUpperCase(), fill: '#F5F5F7', glow: false },
  { text: t.hero.titleAccent.toUpperCase(), fill: '#E4D2FF', glow: true },
  { text: t.hero.titleBottom.toUpperCase(), fill: '#F5F5F7', glow: false },
];
const drawStagger = 0.03;
const lineGap = 0.3;
const drawDuration = 0.45;
const letterDelay = (li: number, i: number) => (0.2 + li * lineGap + i * drawStagger).toFixed(2);
const fillDelay = (li: number, len: number) => (0.2 + li * lineGap + len * drawStagger + 0.15).toFixed(2);
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden">
  <!-- Foto real del lobby: fondo a sangre completa (elemento clave de la landing) -->
  <img
    src="/images/gallery/lobby-1.webp"
    alt="Lobby de Craftland: castillo medieval con portal morado entre abetos"
    width="1920"
    height="1027"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Velo para legibilidad: suave arriba (que respire la foto), denso abajo -->
  <div class="absolute inset-0 bg-gradient-to-b from-night-950/55 via-night-950/25 to-night-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(13,13,15,0.45)_100%)]" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-3xl flex-col items-center px-4 pt-28 pb-20 text-center sm:px-6">
    <!-- Logo centrado arriba -->
    <img
      src="/images/brand/logo-hero.webp"
      alt="Logo de Craftland: jugador con antorcha sobre una isla flotante frente a un castillo"
      width="800"
      height="800"
      class="hero-in w-52 sm:w-64 md:w-80"
      style="--hero-delay: 100ms"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <h1 class="hero-in mt-7 max-w-3xl font-display text-4xl leading-[1.1] uppercase sm:text-5xl md:text-7xl" style="--hero-delay: 300ms">
      <span class="sr-only">{`${t.hero.titleTop} ${t.hero.titleAccent} ${t.hero.titleBottom}`}</span>
      <span class="stroke-title" aria-hidden="true">
        {titleLines.map((line, li) => (
          <svg viewBox="0 0 900 130" class={line.glow ? 'st-line st-glow' : 'st-line'}>
            <text class="st-stroke" x="450" y="100" text-anchor="middle" style="font:800 110px Anton, Impact, sans-serif; letter-spacing:3px;">
              {line.text.split('').map((ch, i) => (
                <tspan style={`animation-delay:${letterDelay(li, i)}s`}>{ch}</tspan>
              ))}
            </text>
            <text class="st-fill" x="450" y="100" text-anchor="middle" style={`font:800 110px Anton, Impact, sans-serif; letter-spacing:3px; fill:${line.fill}; animation-delay:${fillDelay(li, line.text.length)}s;`}>{line.text}</text>
          </svg>
        ))}
      </span>
    </h1>

    <p class="hero-in mt-5 max-w-xl text-lg leading-relaxed text-mist-100 drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]" style="--hero-delay: 420ms">
      {t.hero.subtitle}
    </p>

    <!-- Botones principales: copiar IP y Discord -->
    <div class="hero-in mt-8 flex flex-col items-center gap-4 sm:flex-row" style="--hero-delay: 540ms">
      <button
        type="button"
        class="btn-gloss inline-flex items-center gap-3 bg-grape-500 px-8 py-4 text-lg font-bold text-white shadow-[0_10px_40px_-10px_rgba(138,43,226,0.8)] transition-transform hover:scale-[1.02] active:translate-y-px"
        data-copy-ip={site.serverIp}
        data-copied-label={t.hero.ipCopied}
        aria-label={`Copiar IP ${site.serverIp}`}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span data-copy-label>{t.hero.copyIp}</span>
      </button>

      <a
        href={t.hero.secondaryCtaHref}
        rel="noopener"
        class="btn-gloss inline-flex items-center gap-2 border border-black/40 bg-night-950/75 px-8 py-4 text-lg font-bold text-mist-50 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.9)] backdrop-blur-md transition-all hover:bg-night-950/90 active:translate-y-px"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28c-1.69.28-3.35.77-4.93 1.51A20.26 20.26 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.3-2.1a12.9 12.9 0 0 1-2.05-.98c.17-.12.34-.25.5-.38a14.2 14.2 0 0 0 12.16 0c.16.13.33.26.5.38-.65.39-1.34.71-2.05.98.37.73.81 1.44 1.3 2.1a19.84 19.84 0 0 0 6.07-3.03 20.2 20.2 0 0 0-3.58-13.69zM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42z"/>
        </svg>
        {t.hero.secondaryCta}
      </a>
    </div>

    <!-- IP visible también como texto: clic para copiar -->
    <button
      type="button"
      class="hero-in mt-6 font-mono text-base font-semibold text-mist-200 drop-shadow-[0_1px_4px_rgba(0,0,0,0.9)] transition-colors hover:text-white sm:text-lg"
      style="--hero-delay: 660ms"
      data-copy-ip={site.serverIp}
      data-copied-label="¡IP copiada!"
      aria-label={`Copiar IP ${site.serverIp}`}
    >
      <span class="text-mist-400 uppercase tracking-[0.15em] text-xs">{t.hero.ipLabel}</span>
      <span data-copy-label class="mx-2 text-grape-300">{site.serverIp}</span>
    </button>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#modalidades"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-mist-400 transition-colors hover:text-white"
    aria-label="Bajar a las modalidades"
  >
    <svg class="h-6 w-6 animate-bounce motion-reduce:animate-none drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"></path>
    </svg>
  </a>
</section>
