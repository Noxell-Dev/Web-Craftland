---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<section id="como-entrar" class="blocky-grid bg-night-900 py-20 sm:py-28" aria-labelledby="howto-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-grape-300">{t.howTo.overline}</p>
      <h2 id="howto-title" class="mt-3 font-display text-3xl tracking-wide sm:text-4xl">{t.howTo.title}</h2>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {t.howTo.steps.map((step, i) => (
        <li class="reveal relative" style={`--reveal-delay: ${i * 70}ms`}>
          <div class="block-border border border-white/8 bg-night-800 p-7">
            <p class="font-display text-5xl text-grape-500/40" aria-hidden="true">{step.n}</p>
            <h3 class="mt-4 font-display text-xl tracking-wide">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-mist-400">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="reveal mt-10 flex justify-center" style="--reveal-delay: 200ms">
      <button
        type="button"
        class="rounded-xl bg-grape-500 px-8 py-4 font-display text-lg tracking-wide text-white transition-colors hover:bg-grape-400 active:translate-y-px btn-gloss"
        data-copy-ip={site.serverIp}
        data-copied-label={t.hero.ipCopied}
        aria-label={`Copiar IP ${site.serverIp}`}
      >
        <span data-copy-label>{t.cta.button}</span>
      </button>
    </div>
  </div>
</section>
