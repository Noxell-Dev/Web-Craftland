---
import { t } from '../i18n/es';

const images = ['sin-lag', 'eventos', 'comunidad', 'staff'];
---

<section id="por-que" class="relative py-24 sm:py-28" aria-labelledby="porque-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-grape-400">{t.why.overline}</p>
    <h2 id="porque-title" data-split class="reveal mt-3 font-display text-4xl tracking-wide text-mist-50 sm:text-5xl">
      {t.why.title}
    </h2>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {t.why.features.map((feature, i) => (
        <li
          class="why-card reveal group relative overflow-hidden rounded-2xl border border-white/10 transition-all duration-300 hover:-translate-y-1 hover:border-grape-400/50 hover:shadow-[0_12px_40px_-8px_rgba(138,43,226,0.5)]"
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="relative h-72 overflow-hidden sm:h-80">
            <img
              src={`/images/why/${images[i]}.webp`}
              alt={feature.title}
              width="800"
              height="446"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/40 to-transparent"
            ></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <h3 class="font-display text-xl tracking-wide text-mist-50 drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
                {feature.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-mist-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
                {feature.description}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
