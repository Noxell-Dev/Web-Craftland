---
import { t } from '../i18n/es';

const images = ['sin-lag', 'eventos', 'comunidad', 'staff'];
---

<section id="por-que" class="relative overflow-hidden py-24 sm:py-28" aria-labelledby="porque-title">
  <!-- Ambiente: glows morados -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-64 w-[42rem] -translate-x-1/2 rounded-full bg-grape-500/8 blur-3xl"></div>
    <div class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-grape-700/10 blur-3xl"></div>
    <div class="absolute -right-24 top-1/3 h-72 w-72 rounded-full bg-grape-600/8 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-grape-400">{t.why.overline}</p>
    <h2 id="porque-title" data-split class="reveal mt-3 font-display text-4xl tracking-wide text-mist-50 sm:text-5xl">
      {t.why.title}
    </h2>

    <div
      class="accordion-gallery reveal mt-12"
      data-accordion
      role="list"
      aria-label="Por qué Craftland"
      style="--ag-accent: #a855f7; --ag-overlay: #060010; --ag-text: #ffffff;"
    >
      {t.why.features.map((feature, i) => (
        <div
          class:list={['ag-panel', i === 0 && 'ag-panel--active']}
          role="listitem"
          tabindex="0"
          aria-label={feature.title}
          data-index={i}
        >
          <span class="ag-panel__frame">
            <span class="ag-panel__media">
              <img
                src={`/images/why/${images[i]}.webp`}
                alt={feature.title}
                width="800"
                height="446"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
            </span>
            <span class="ag-panel__overlay" aria-hidden="true"></span>
          </span>
          <span class="ag-panel__label" aria-hidden="true">
            <span class="ag-panel__bar"></span>
            <span class="ag-panel__text">
              <span class="ag-panel__title">{feature.title}</span>
              <span class="ag-panel__desc">{feature.description}</span>
            </span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
