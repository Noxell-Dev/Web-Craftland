---
import { t } from '../i18n/es';

const icons: Record<string, string> = {
  bolt: '<path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  users: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
const iconKeys = ['bolt', 'calendar', 'users', 'shield'];
---

<section id="por-que" class="relative py-24 sm:py-28" aria-labelledby="porque-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-grape-400">{t.why.overline}</p>
    <h2 id="porque-title" data-split class="reveal mt-3 font-display text-4xl tracking-wide text-mist-50 sm:text-5xl">
      {t.why.title}
    </h2>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {t.why.features.map((feature, i) => (
        <li
          data-spotlight
          data-spotlight-color="rgba(51,204,51,0.16)"
          class="spotlight-card reveal group relative overflow-hidden rounded-2xl border border-white/10 bg-night-800 p-6 transition-transform duration-200 hover:-translate-y-1 hover:border-lime-online/40"
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mb-4 h-8 w-8 text-lime-online"
            set:html={icons[iconKeys[i]]}
          />
          <h3 class="text-lg font-bold text-mist-50">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{feature.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
