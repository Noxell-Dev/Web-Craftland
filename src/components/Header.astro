---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<header id="site-header" class="fixed inset-x-0 top-3 z-50 px-3 sm:top-4 sm:px-4">
  <div
    class="liquid-glass mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 rounded-2xl px-4 transition-all duration-300 sm:px-5"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-xl tracking-wide text-mist-50"
      aria-label={`${site.name} — inicio`}
    >
      <img src="/images/brand/logo-hero.webp" alt="" width="32" height="32" class="h-8 w-8 rounded object-cover" loading="eager" />
      <span>CRAFT<span class="text-grape-400">LAND</span></span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="rounded-xl px-3.5 py-2 text-sm font-medium text-mist-400 transition-colors hover:bg-white/10 hover:text-mist-50"
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.discordUrl}
        rel="noopener"
        data-magnet
        class="ml-2 rounded-xl bg-grape-500 px-4 py-2 text-sm font-bold text-white shadow-[0_4px_18px_rgba(138,43,226,0.4)] transition-colors hover:bg-grape-400 active:translate-y-px btn-gloss"
      >
        {t.joinCta}
      </a>
    </nav>

    <button
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-mist-50 hover:bg-white/10 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open-label={t.openMenu}
      data-close-label={t.closeMenu}
      aria-label={t.openMenu}
    >
      <svg data-icon-open class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg data-icon-close class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="liquid-glass mx-auto mt-2 max-w-6xl rounded-2xl px-4 pb-4 pt-2 md:hidden"
  >
    <nav class="flex flex-col" aria-label="Móvil">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="rounded-xl px-2 py-3 text-base font-medium text-mist-200 hover:bg-white/10"
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.discordUrl}
        rel="noopener"
        class="mt-2 rounded-xl bg-grape-500 px-4 py-3 text-center text-base font-bold text-white transition-colors hover:bg-grape-400 btn-gloss"
      >
        {t.joinCta}
      </a>
    </nav>
  </div>
</header>
