---
import { t } from '../i18n/es';
import { site } from '../data/site';
---

<header id="site-header" class="fixed inset-x-0 top-3 z-50 px-3 sm:top-4 sm:px-4">
  <div
    class="liquid-glass mx-auto flex h-14 max-w-4xl items-center justify-between gap-4 pl-4 pr-2 transition-all duration-300"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-lg tracking-wide text-mist-50"
      aria-label={`${site.name} — inicio`}
    >
      <img src="/images/brand/logo-hero.webp" alt="" width="28" height="28" class="h-7 w-7 object-cover" loading="eager" />
      <span>CRAFT<span class="text-grape-400">LAND</span></span>
    </a>

    <nav class="hidden items-center gap-5 md:flex" aria-label="Principal">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="whitespace-nowrap text-sm font-medium text-mist-400 transition-colors hover:text-mist-50"
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.discordUrl}
        rel="noopener"
        data-magnet
        class="whitespace-nowrap bg-mist-50 px-5 py-2 text-sm font-semibold text-night-950 transition-all hover:bg-white hover:shadow-[0_4px_20px_rgba(255,255,255,0.25)] active:scale-[0.98]"
      >
        {t.joinCta}
      </a>
    </nav>

    <button
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center text-mist-50 hover:bg-white/10 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open-label={t.openMenu}
      data-close-label={t.closeMenu}
      aria-label={t.openMenu}
    >
      <svg data-icon-open class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg data-icon-close class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="liquid-glass mx-auto mt-2 max-w-4xl px-4 pb-4 pt-2 md:hidden"
  >
    <nav class="flex flex-col" aria-label="Móvil">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="rounded-2xl px-3 py-3 text-base font-medium text-mist-200 hover:bg-white/10"
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.discordUrl}
        rel="noopener"
        class="mt-2 bg-mist-50 px-4 py-3 text-center text-base font-semibold text-night-950 transition-colors hover:bg-white"
      >
        {t.joinCta}
      </a>
    </nav>
  </div>
</header>
