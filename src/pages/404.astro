---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/es';
import { site } from '../data/site';

const title = `Página no encontrada — ${site.name}`;
const description = 'La página que buscas no existe.';
---

<BaseLayout title={title} description={description} path="/404">
  <section class="blocky-grid flex min-h-[70vh] items-center bg-night-900 py-20">
    <div class="mx-auto max-w-xl px-4 text-center sm:px-6">
      <p class="font-display text-7xl text-grape-500">404</p>
      <h1 class="mt-4 font-display text-3xl tracking-wide">{t.notFound.title}</h1>
      <p class="mt-4 text-lg text-mist-400">{t.notFound.body}</p>
      <a
        href="/"
        class="mt-8 inline-block rounded-xl bg-grape-500 px-7 py-3.5 font-bold text-white transition-colors hover:bg-grape-400 active:translate-y-px btn-gloss"
      >
        {t.notFound.cta}
      </a>
    </div>
  </section>
</BaseLayout>
