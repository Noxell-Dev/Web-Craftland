---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { t } from '../i18n/es';

const title = `Mapa del Survival — ${site.name}`;
const description = `Mapa interactivo del Survival de ${site.name}: explora el mundo, ve jugadores en tiempo real y encuentra puntos de interés.`;
---

<BaseLayout title={title} description={description} path="/mapa">
  <Header />

  <main>
    <!-- Hero del mapa -->
    <section class="relative overflow-hidden bg-night-900 pb-16 pt-32 sm:pb-20 sm:pt-40">
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-0 h-72 w-[46rem] -translate-x-1/2 rounded-full bg-grape-500/15 blur-3xl"
      ></div>

      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-grape-300">
          {t.mapa.overline}
        </p>
        <h1 class="reveal mt-4 font-display text-4xl tracking-wide text-mist-50 sm:text-5xl" style="--reveal-delay: 80ms">
          {t.mapa.title}
        </h1>
        <p class="reveal mx-auto mt-5 max-w-2xl leading-relaxed text-mist-300" style="--reveal-delay: 160ms">
          {t.mapa.subtitle}
        </p>

        <div class="reveal mt-8" style="--reveal-delay: 240ms">
          <a
            href={site.mapUrl}
            target="_blank"
            rel="noopener"
            data-magnet
            class="inline-block bg-grape-500 px-10 py-4 font-bold text-white transition-all hover:bg-grape-400 hover:shadow-[0_8px_32px_rgba(138,43,226,0.5)] active:translate-y-px btn-gloss"
          >
            {t.mapa.openCta}
          </a>
          <p class="mt-3 text-sm text-mist-500">{t.mapa.openNote}</p>
        </div>
      </div>
    </section>

    <!-- Vista previa del mapa -->
    <section class="relative bg-night-900 pb-16 sm:pb-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <a
          href={site.mapUrl}
          target="_blank"
          rel="noopener"
          class="reveal group relative block overflow-hidden border border-white/10"
          aria-label={t.mapa.openCta}
        >
          <img
            src="/images/gallery/lobby-1.webp"
            alt="Vista del mundo Survival de Craftland"
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-night-950/80 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-3 p-6">
            <span class="bg-mist-50 px-6 py-3 text-sm font-bold text-night-950 transition-colors group-hover:bg-white">
              {t.mapa.openCta} ↗
            </span>
          </div>
        </a>
      </div>
    </section>

    <!-- Features -->
    <section class="bg-night-900 pb-20 sm:pb-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-5 sm:grid-cols-3">
          {t.mapa.features.map((f, i) => (
            <div
              class="reveal border border-white/10 bg-night-800/60 p-6 backdrop-blur-sm"
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <p class="font-display text-lg tracking-wide text-mist-50">{f.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-mist-400">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
